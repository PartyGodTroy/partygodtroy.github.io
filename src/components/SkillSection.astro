---
import Skill from './Skill';
---


<section class="max-w-[1280px] mx-auto px-4 lg:px-0">
    <div class="my-10">
      <h2 class="text-4xl leading-9 font-bold site-name">Skill Summary</h2>
    </div>
    <div class="flex gap-8 flex-wrap">
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">Javascript</h3>
        <div class="flex gap-4 flex-wrap">
          <!-- JAVASCRIPT -->
          <Skill name="Node" points={8} years={6} client:load />
          <Skill name="React" points={8} years={8} client:load />
          <Skill name="Vue" points={5} years={3} client:load />
          <Skill name="NextJS" points={8} years={2} client:load />
          <Skill name="Astro" points={8} years={4} client:load />
        </div>
      </div>
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">.NET</h3>
        <div class="flex gap-4 flex-wrap">
          <Skill name="Umbraco" points={8} client:load />
          <Skill name="ASP.NET" points={8} client:load />
          <Skill name="ASP.NET Core" points={7} client:load />
        </div>
      </div>
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">CSS</h3>
        <div class="flex gap-4 flex-wrap">
          <Skill name="Tailwind" points={8} client:load />
          <Skill name="Bootstrap" points={10} client:load />
        </div>
      </div>
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">PHP</h3>
        <div class="flex gap-4 flex-wrap">
          <Skill name="Wordpress" points={8} client:load />
          <Skill name="Symphony" points={4} client:load />
          <Skill name="Drupal" points={5} client:load />
        </div>
      </div>
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">Databases</h3>
        <div class="flex gap-4 flex-wrap">
          <!-- SQL -->
          <Skill name="MySQL" points={5} client:load />
          <Skill name="MSSQL" points={8} client:load />
          <Skill name="Postgres" points={7} client:load />
        </div>
      </div>
      <div class="border-2 border-gray-200 p-4 rounded-lg">
        <h3 class="text-3xl font-bold leading-16">Software & Softskills</h3>
        <div class="flex gap-4 flex-wrap">
          <!-- SQL -->
          <Skill name="Lean Six Sigma" points={7} client:load />
          <Skill name="Figma" points={8} client:load />
          <Skill name="Azure" points={7} client:load />
        </div>
      </div>
    </div>
  </section>