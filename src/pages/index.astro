---
import Hero from "@/components/Hero.astro";
import Bio from "@/components/Bio.astro";
import Layout from "@/layouts/Layout.astro";
import BlogPostPreview from "@/components/BlogPostPreview.astro";
import type { Post } from "@/site";

export const posts = (await Astro.glob("./blog/posts/*.astro")).map((v) => (v as any).post as Post).sort((a, b) => (a.date > b.date ? -1 : 1)).filter(p => p.hidden != true);
export const tags = posts.map( p => p.tags).flat().filter( (v, i, a) => a.indexOf(v) === i).sort()

---

<Layout>
	<Hero h1="The Greatest Blog Ever" content="Web Developer">
		<div slot="image-section">
			<img src="/blog/cover.webp" width="200" alt="mockup">
		</div>
	</Hero>
	<div class="mx-auto max-w-[1280px] p-5 " >
		<div class=" max-w-7xl mx-auto">
			<h2 class="text-4xl mb-5 font-bold">Tags</h1>
		</div>
		<div class="mb-5 flex gap-3 flex-wrap  max-w-7xl mx-auto" id="tag_container">
			<button data-tag="latest"  
				name="Latest Post Tag" 
				onclick="selectTag(event)"
				class="tag active transition-all bg-gray-200 text-gray-800 px-2 py-1 rounded-lg mr-2">
				Latest
			</button>
			{tags.map( tag => {
				return <button 
							data-tag={tag} 
							title={`Tag ${tag}`} 
							onclick="selectTag(event)"
							class="tag cursor-pointer transition-all bg-gray-200 text-gray-800 px-2 py-1 rounded-lg mr-2 whitespace-nowrap">
								{tag}
					  </button>
			})}
		</div>

		<div class="grid xl:grid-cols-2 gap-6 blog-listing-tl  max-w-7xl mx-auto" id="post_container" >
			{posts.map( p =>{
				return <BlogPostPreview post={p} />
			})}
		</div>
</div>
<script is:inline>

window.selectTag = (event) => {

	document.startViewTransition(()=>{
		const target = event.target;
const tag = target.dataset.tag;
[...post_container.children].forEach( (_) => {
    const v = _;
    if(tag === "latest"){
        v.style.display = "block";
    }else{
        if( v.dataset.tags && v.dataset.tags.split(",").includes(tag)){
            v.style.display = "block";
        }else{
            v.style.display = "none";
        }
    }

    [...v.querySelectorAll(".tag")].forEach( _ => {
        const aTag = _;
        if(aTag.dataset.tag && aTag.dataset.tag === tag){
            aTag.classList.add("active");
        }else{
            aTag.classList.remove("active");
        }
    })
});
[...tag_container.children].forEach( (_) => {
    const v = _;
    if(v === target){
        v.classList.add("active");
    }else{
        v.classList.remove("active");
    }
})
	})


}
</script>
<style is:global>
	@reference "tailwindcss";
	.tag{
		padding: 0.2em 0.5em;
		&.active{
			background-color: #000;
			color: #fff;
		}
	}
	@keyframes move-out {
  from {
    transform: translateY(0%);
  }

  to {
    transform: translateX(-100%);
  }
}

@keyframes move-in {
  from {
    transform: translateX(100%);
  }

  to {
    transform: translateX(0%);
  }
}
.blog-listing-tl{
  view-transition-name: blog-listing;
  
}
::view-transition-old(blog-listing) {
  animation: 0.4s ease-in both move-out;
}

::view-transition-new(blog-listing) {
  animation: 0.4s ease-in both move-in;
}

</style>
</Layout>	