---
import Hero from "../components/Hero.astro";
import Bio from "../components/Bio.astro";
import Layout from "../layouts/Layout.astro";
import Sidebar from "@/layouts/Header.astro";
import Slider from "@/components/Slider.astro";
import Slide from "@/components/Slide.astro";
import BioSpot from "@/components/BioSpot.astro";
import PortfolioPiece from "@/components/PortfolioPiece.astro";
import Skill from "@/components/Skill";
import SkillSection from "@/components/SkillSection.astro";
---

<style is:global>
  @reference "tailwindcss";
  .hero:has(.cover) {
    position: relative;
    &:after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-position: center -200px;
      background-size: auto 100vw;
      object-fit: contain;
      opacity: 0.2;
      @media (max-width: 768px) {
        background-position: top;
      }
    }
  }
</style>
<Layout title="Ventroy's Blog">
  <Hero h1="Ventroy Rolle" content="Web Developer" class="cover">
    <div slot="image-section">
      <!-- <img src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/hero/phone-mockup.png" width="200" alt="mockup"> -->
    </div>
  </Hero>
  <section class="max-w-[1280px] mx-auto px-4 lg:px-0">
    <div class="my-10  max-w-7xl mx-auto">
      <h2 class="text-4xl leading-9 font-bold site-name">Professional Work</h2>
    </div>
    <div class="grid xl:grid-cols-3 lg:grid-cols-2 grid-col-1 mb-4 gap-4 max-w-7xl mx-auto">
      <PortfolioPiece
        title="Brunnerworks.com"
        summary="Brunnerworks site built with Next.js, Vercel, and Builder.io"
        url="https://brunnerworks.com"
        image={{
          src: "/brunner-sc.png",
          alt: "brunner website",
        }}
      />
      <PortfolioPiece
        title="Brusters.com"
        summary="Brusters marketing site built with React and Umbraco"
        url="https://brusters.com"
        image={{
          src: "/brusters-sc.png",
          alt: "brusters website",
        }}
      />
      <PortfolioPiece
        title="Green Building Alliance"
        summary="GBA site built with Vue and Umbraco"
        url="https://gba.org"
        image={{
          src: "/gba-sc.png",
          alt: "brusters website",
        }}
      />
          <PortfolioPiece
        title="Wesbanco"
        summary="Wordpress site for Wesbanco built with Elementor"
        url="https://wesbanco.com"
        image={{
          src: "/wesbanco-sc.png",
          alt: "Wesbanco website",
        }}
      />

          <PortfolioPiece
        title="Goodwill of North GA"
        summary="Wordpress site for Goodwill of North GA built with ACF"
        url="https://goodwillng.com"
        image={{
          src: "/goodwill-sc.png",
          alt: "Goodwill of North GA",
        }}
      />

      <PortfolioPiece
        title="Advect"
        summary="Component for building and sharing webcomponents"
        url="https://advect.org"
        image={{
          src: "/advect-sc.png",
          alt: "advect webcomponent website",
        }}
      />
      <hr />
    </div>

    <div class="my-10  max-w-7xl mx-auto">
      <h2 class="text-4xl leading-9 font-bold site-name">Code Pens</h2>
    </div>
    <div class="grid xl:grid-cols-3 lg:grid-cols-2 grid-col-1 mb-4 gap-4  max-w-7xl mx-auto">
      <PortfolioPiece
        title="Content Drawer"
        summary="Component for building and sharing webcomponents"
        url="https://codepen.io/PartyGodTroy/details/qBNoaOM"
        image={{
          src: "https://shots.codepen.io/username/pen/qBNoaOM-800.jpg?version=1604280742",
          alt: "Code Pen",
        }}
      />
      <PortfolioPiece
        title="Playing with new CSS transitions"
        summary="CSS transitions and animations"
        url="https://codepen.io/PartyGodTroy/full/RwqvjNK"
        image={{
          src: "https://shots.codepen.io/username/pen/xbKQLyQ-512.jpg?version=1738027936",
          alt: "Code Pen",
        }}
      />

      <PortfolioPiece
        title="Character Select Screen"
        summary="Proof of concept for a character select screen"
        url="https://codepen.io/PartyGodTroy/pen/XWREYqO"
        image={{
          src: "https://shots.codepen.io/username/pen/XWREYqO-512.jpg?version=1722627630",
          alt: "Code Pen",
        }}
      />
    </div>
    <div class="py-5 flex justify-center">
      <a
        class="flex items-center gap-2 text-2xl font-bold"
        href="https://codepen.io/PartyGodTroy"
        target="_blank"
      >
        View All
        <svg
          xmlns="http://www.w3.org/2000/svg"
          x="0px"
          y="0px"
          width="30"
          height="50"
          viewBox="0 0 50 50"
        >
          <path
            d="M 25 4 L 4 17.34375 L 4 32.652344 L 25 46 L 46 32.65625 L 46 17.34375 Z M 25 29.183594 L 19.066406 25.070313 L 25 21.023438 L 30.933594 25.070313 Z M 27 17.605469 L 27 9.949219 L 40.429688 18.484375 L 34.410156 22.65625 Z M 23 17.605469 L 15.589844 22.65625 L 9.570313 18.484375 L 23 9.949219 Z M 12.09375 25.042969 L 8 27.832031 L 8 22.203125 Z M 15.570313 27.453125 L 23 32.605469 L 23 40.050781 L 9.589844 31.527344 Z M 27 32.605469 L 34.429688 27.453125 L 40.410156 31.527344 L 27 40.050781 Z M 37.90625 25.042969 L 42 22.203125 L 42 27.832031 Z"
          ></path>
        </svg>
      </a>
      <hr />
    </div>

  </section>
  <div class="max-w-7xl mx-auto">
    <SkillSection  />
  </div>

</Layout>
