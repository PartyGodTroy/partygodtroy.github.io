---
import BlogLayout from "@/layouts/BlogLayout.astro";
import type { Post } from "@/site";

export const post: Post = {
  title: "A new Web Component Framework",
  description: "A simple code editor that can be used in any web project.",
  tags: ["web components","advect"],
  slug: "introducing-advect",
  date: Date.parse("2024-12-01"),
  boosted: false,
  featured_img: {
    url: "/advect-sc.png",
    alt: "A random image from picsum",
    width: 300,
    height: 300,
  },
};
---

<script>
  import "htmx.org";
</script>

<BlogLayout post={post}>
  <div class="pt-10">
    <section class="max-w-screen-lg mx-auto grid gap-5 p-5"></section>
  </div>
</BlogLayout>

<style>
  @reference "tailwindcss";
  h2 {
    @apply text-4xl font-bold py-2;
    @apply text-purple-900;
  }
  h3 {
    @apply text-3xl font-bold py-2;
    @apply text-orange-500;
  }
  h4 {
    @apply text-2xl font-bold py-2;
  }
  p {
    @apply text-xl;
  }
  section {
    @apply mt-3;
  }
  b {
    @apply text-orange-500;
  }
</style>
