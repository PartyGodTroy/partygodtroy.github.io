---
import Hero from "../components/Hero.astro";
import Layout from "./Layout.astro";
---

<Layout title={Astro.props.title}>
	<div class="max-w-[1280px]">

    <a class="block p-1 text-md text-white absolute font-bold transition-all group z-10" href="/" >
		<span class="text-4xl group-hover:animate-bounce">👈🏿</span>	
		<span>Back to Blog</span>
	</a>
</div>

    <Hero class="top-10 pb-10" h1={Astro.props.post.title} content={Astro.props.post.description}>
		<div slot="image-section">
			<img class="rounded-full object-scale-down w-[300px] h-[300px]" src={Astro.props.post.featured_img.url} alt={Astro.props.post.featured_img.alt} width={Astro.props.post.featured_img.width} height={Astro.props.post.featured_img.height}  >
		</div>
	</Hero>
    <slot></slot>
</Layout>